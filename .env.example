# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Obtain from Google Analytics Admin > Data Streams > Web Stream Details
VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML Tag Verification Token (optional if using DNS TXT record)
# Obtain from Google Search Console > Settings > Ownership verification > HTML tag
VITE_GSC_VERIFICATION_TOKEN=
